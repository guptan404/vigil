{
  "name": "vigil-workspace",
  "private": true,
  "license": "BSD-3-Clause",
  "workspaces": [
    "node/packages/*",
    "example/node_server"
  ],
  "scripts": {
    "build": "npm --workspaces --if-present run build",
    "test": "npm --workspaces --if-present test",
    "check": "npm run build && npm test",
    "test:integration": "npm run build && cd dart/vigil_backend && dart test test/protocol_integration.dart",
    "pack:check": "npm pack --dry-run --workspace @vigiljs/core --workspace @vigiljs/express",
    "preview": "node tool/preview.mjs",
    "prepare": "node tool/prepare_git_package.mjs"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3",
    "supertest": "^7.3.0"
  },
  "version": "0.1.2",
  "main": "./git-dist/express/index.js",
  "types": "./git-dist/express/index.d.ts",
  "exports": {
    ".": {
      "types": "./git-dist/express/index.d.ts",
      "import": "./git-dist/express/index.js",
      "default": "./git-dist/express/index.js"
    }
  },
  "files": [
    "git-dist",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "express": ">=4.18.0 <6"
  }
}
