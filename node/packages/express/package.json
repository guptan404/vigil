{
  "name": "@vigiljs/express",
  "version": "0.1.1",
  "license": "BSD-3-Clause",
  "description": "Express middleware for Vigil trace correlation, Server-Timing, gated diagnostics, and client-call ingestion.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "keywords": [
    "vigil",
    "express",
    "observability",
    "server-timing",
    "debugging"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guptan404/vigil.git",
    "directory": "node/packages/express"
  },
  "bugs": {
    "url": "https://github.com/guptan404/vigil/issues"
  },
  "homepage": "https://github.com/guptan404/vigil#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@vigiljs/core": "0.1.1"
  },
  "peerDependencies": {
    "express": ">=4.18.0 <6"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/supertest": "^7.2.1",
    "express": "^5.2.1",
    "supertest": "^7.3.0",
    "vitest": "^5.0.3"
  }
}
